# Copy this file to `.env` and fill in real values for local development.
# `.env` is gitignored — NEVER commit real credentials.
#
# In Azure (staging/prod), these env vars are injected by App Service from
# Azure Key Vault references — see docs/azure-setup.md.

# JDBC connection string for the application
DB_URL=jdbc:postgresql://localhost:5434/mrp_db
DB_USER=postgres
DB_PASSWORD=changeme

# Used by docker-compose to seed the local Postgres container.
# Keep these aligned with DB_USER / DB_PASSWORD above for local dev.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=changeme
POSTGRES_DB=mrp_db
